{
  "version": 2,
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "serial=(self), geolocation=(self), microphone=(self), camera=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.paystack.co; frame-src 'self' https://accounts.google.com https://checkout.paystack.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.paystack.co https://api.ipify.org https://nominatim.openstreetmap.org https://*.r2.dev https://*.cloudflarestorage.com https://images.urbanautoexpress.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' blob: data:; worker-src 'self' blob:;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/telegram/daily-summary?period=morning",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/telegram/daily-summary?period=evening",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/telegram/monitor",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/telegram/daily-summary?period=hourly",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/telegram/daily-summary?period=weekly",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/telegram/daily-summary?period=station-sales",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/telegram/daily-summary?period=cashier-hourly",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/telegram/daily-summary?period=top-items-12h",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/telegram/stock-monitor",
      "schedule": "*/15 * * * *"
    }
  ]
}
