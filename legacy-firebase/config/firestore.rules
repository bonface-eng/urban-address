rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    // PIN-issued custom tokens are for routine terminal work only. Privileged
    // administration requires a normal Firebase email/password session.
    function isFullAuth() {
      return isSignedIn() && request.auth.token.get('terminalStaffSession', false) != true;
    }
    function userExists(uid) { return exists(/databases/$(database)/documents/users/$(uid)); }
    function userData(uid) {
      return userExists(uid) ? get(/databases/$(database)/documents/users/$(uid)).data : {};
    }
    function role() {
      let value = isSignedIn() ? userData(request.auth.uid).get('role', 'CLIENT') : 'CLIENT';
      return value is string ? value.upper() : 'CLIENT';
    }
    // Administrator OTP claims are issued for the current UTC calendar day.
    // Compare individual UTC date parts because Firestore Rules cannot format timestamps.
    function hasDailyAdminOtp() {
      return isSignedIn()
        && request.auth.token.get('adminOtpVerifiedYear', 0) == request.time.year()
        && request.auth.token.get('adminOtpVerifiedMonth', 0) == request.time.month()
        && request.auth.token.get('adminOtpVerifiedDay', 0) == request.time.day();
    }
    function isSuperAdmin() {
      let email = isSignedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower() : '';
      return isFullAuth() && hasDailyAdminOtp() && email != '' && (
        email in [
          'urbanautoexpressnakuru@gmail.com',
          'urbanaautoexpressnakuru@gmail.com',
          'samuelkarani044@gmail.com',
          'gmaina424@gmail.com',
          'bonfacewana3072@gmail.com'
        ] || exists(/databases/$(database)/documents/admins/$(email))
      );
    }
    function isAdmin() {
      return isFullAuth() && (
        (role() == 'ADMIN' && hasDailyAdminOtp())
        || role() in ['MANAGER', 'SUPERVISOR']
        || isSuperAdmin()
      );
    }
    // Live audio is restricted to OTP-verified ADMIN and super-admin accounts.
    function isAudioAdmin() {
      return isFullAuth() && (
        (role() == 'ADMIN' && hasDailyAdminOtp()) || isSuperAdmin()
      );
    }
    function isKitchen() { return isSignedIn() && role() == 'KITCHEN'; }
    function isStaff() {
      return isSignedIn() && (
        (role() == 'ADMIN' && hasDailyAdminOtp())
        || role() in ['MANAGER', 'SUPERVISOR', 'CASHIER', 'STOREKEEPER', 'ATTENDANT', 'KITCHEN']
        || isSuperAdmin()
      );
    }
    function ownsUser(uid) { return isSignedIn() && request.auth.uid == uid; }
    function safeClientOrder() {
      return isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status in ['PENDING', 'UNPAID', 'AWAITING_PAYMENT']
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.keys().hasAll(['customerId', 'status', 'total', 'timestamp']);
    }

    // User-owned operational subcollections are authorized only by their explicit parent paths below.

    match /terminal_pin_attempts/{userId} {
      allow read, write: if false;
    }

    // Terminal account membership and PIN hashes are server-only (Firebase Admin SDK).
    match /terminal_devices/{deviceId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /live_audio_sessions/{sessionId} {
      allow create: if isAudioAdmin()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'REQUESTED'
        && request.resource.data.cashierId is string
        && request.resource.data.terminalId is string;
      allow read: if isAudioAdmin()
        || (isSignedIn() && resource.data.cashierId == request.auth.uid);
      allow update: if isAudioAdmin()
        || (
          isSignedIn()
          && resource.data.cashierId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acceptedAt', 'acceptedBy', 'cashierName', 'offer',
            'declinedAt', 'declinedBy', 'endedAt', 'endedBy'
          ])
          && request.resource.data.status in ['ACCEPTED', 'DECLINED', 'ENDED']
        );
      allow delete: if false;

      match /staff_candidates/{candidateId} {
        allow read: if isAudioAdmin();
        allow create: if isSignedIn()
          && exists(/databases/$(database)/documents/live_audio_sessions/$(sessionId))
          && get(/databases/$(database)/documents/live_audio_sessions/$(sessionId)).data.cashierId == request.auth.uid
          && get(/databases/$(database)/documents/live_audio_sessions/$(sessionId)).data.status == 'ACCEPTED';
        allow update, delete: if false;
      }
      match /admin_candidates/{candidateId} {
        allow read: if isSignedIn()
          && exists(/databases/$(database)/documents/live_audio_sessions/$(sessionId))
          && get(/databases/$(database)/documents/live_audio_sessions/$(sessionId)).data.cashierId == request.auth.uid;
        allow create: if isAudioAdmin()
          && exists(/databases/$(database)/documents/live_audio_sessions/$(sessionId))
          && get(/databases/$(database)/documents/live_audio_sessions/$(sessionId)).data.status == 'ACCEPTED';
        allow update, delete: if false;
      }
    }

    match /users/{userId} {
      // Clients can read their own profile. Non-kitchen staff need staff/customer lookup,
      // payroll and administration workflows; kitchen accounts do not need global profiles.
      allow read: if ownsUser(userId) || (isStaff() && !isKitchen());
      allow create: if ownsUser(userId)
        && request.resource.data.get('role', 'CLIENT') == 'CLIENT'
        && !('masterKey' in request.resource.data);
      allow update: if isAdmin() || (
        ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phoneNumber', 'photoURL', 'mpesaNumber', 'address', 'deliveryLocation',
          'updatedAt', 'preferences', 'termsAcceptedAt', 'termsVersion'
        ])
      ) || (
        ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenVersions'])
        && request.resource.data.get('seenVersions', []) is list
        && request.resource.data.get('seenVersions', []).hasAll(resource.data.get('seenVersions', []))
        && request.resource.data.get('seenVersions', []).size()
          <= resource.data.get('seenVersions', []).size() + 1
      );
      allow delete: if isAdmin();
      match /held_bills/{billId} {
        // Cashiers and other non-kitchen staff use held bills for POS recall.
        allow read, write: if ownsUser(userId) || (isStaff() && !isKitchen());
      }
      match /fleet/{fleetId} {
        // Fleet records are managed by the customer and authorized non-kitchen staff.
        allow read, write: if ownsUser(userId) || (isStaff() && !isKitchen());
      }
      match /ai_chats/{chatId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }
      match /memories/{memoryId} {
        allow read, write: if ownsUser(userId) || isAdmin();
      }
    }

    // Customer-facing digital menu: public can read only the published main menu.
    // Only administrators can create, update or remove menu configuration.
    match /digitalMenus/{menuId} {
      allow read: if isAdmin() || (menuId == 'main' && resource.data.status == 'PUBLISHED');
      allow create, update: if isAdmin()
        && menuId == 'main'
        && request.resource.data.keys().hasAll(['status', 'items', 'updatedAt', 'updatedBy'])
        && request.resource.data.status in ['DRAFT', 'PUBLISHED']
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin() && menuId == 'main';
    }

    match /inventory/{productId} {
      // Stock-level changes require the owner/super-admin or a server-side
      // approved stock-adjustment transaction. Managers and storekeepers submit requests.
      allow read: if isStaff();
      allow create: if isStaff() && !isKitchen() && isAdmin();
      allow update: if isStaff() && !isKitchen()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stockLevel'])
          || request.resource.data.stockLevel < resource.data.stockLevel
          || isSuperAdmin()
        );
      allow delete: if isAdmin();
    }
    match /orders/{orderId} {
      // Kitchen is a preparation station, not a sales-entry role.
      allow create: if (isStaff() && !isKitchen()) || safeClientOrder();
      allow read: if isStaff()
        || (isSignedIn() && resource.data.cashierId == request.auth.uid)
        || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin() || (isStaff() && !isKitchen()) || (
        isKitchen()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'kitchenStatus', 'prepStatus', 'updatedAt', 'kitchenUpdatedAt', 'servedAt'
        ])
        && request.resource.data.prepStatus in ['NEW', 'PREPARING', 'READY', 'SERVED']
        && (
          !('servedAt' in request.resource.data)
          || (request.resource.data.prepStatus == 'SERVED' && request.resource.data.servedAt is number)
        )
      );
      allow delete: if isAdmin();
    }
    match /carwash_jobs/{jobId} {
      allow read: if isSignedIn() && (isStaff() || resource.data.customerId == request.auth.uid);
      allow create: if isStaff() || (
        isSignedIn() && request.resource.data.customerId == request.auth.uid
      );
      allow update: if isStaff() && !isKitchen();
      allow delete: if isAdmin();
    }
    // Error telemetry is separate from financial audit records.
    match /system_incidents/{incidentId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['incidentId', 'category', 'message', 'route', 'status', 'createdAt', 'userId', 'userAgent'])
        && request.resource.data.incidentId is string
        && request.resource.data.incidentId.size() <= 80
        && request.resource.data.category in ['CLIENT_ERROR', 'UNHANDLED_REJECTION', 'FIRESTORE_PERMISSION']
        && request.resource.data.message is string && request.resource.data.message.size() <= 240
        && request.resource.data.route is string && request.resource.data.route.size() <= 160
        && request.resource.data.status == 'OPEN'
        && request.resource.data.createdAt is number
        && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 180;
      // Incident telemetry can expose internal routes and user identifiers; keep it owner-only.
      allow read: if isSuperAdmin();
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy'])
        && request.resource.data.status in ['OPEN', 'ACKNOWLEDGED', 'RESOLVED'];
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      // Client audit entries are not accepted. Staff-created audit events must
      // originate from a non-kitchen operational session.
      allow create: if isStaff() && !isKitchen();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /suppliers/{supplierId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /petty_cash/{requestId} {
      allow read, create: if isStaff() && !isKitchen();
      allow update, delete: if isAdmin();
    }
    match /reconciliations/{id} {
      allow read, write: if isAdmin();
    }
    match /salary_advances/{id} {
      allow read: if isStaff() && !isKitchen();
      allow write: if isAdmin();
    }
    match /pos_terminals/{id} {
      allow read: if isStaff();
      // Remote lock flags are server-controlled; clients cannot bypass a Telegram lock.
      allow create: if isStaff() && !isKitchen()
        && !request.resource.data.keys().hasAny(['disabled', 'locked', 'forceLockAt', 'forceLockReason']);
      allow update: if isStaff() && !isKitchen()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled', 'locked', 'forceLockAt', 'forceLockReason']);
      allow delete: if isAdmin();
    }
    match /register_sessions/{id} {
      allow read, write: if isStaff() && !isKitchen();
    }
    match /support_queries/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'timestamp'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string && request.resource.data.subject.size() >= 2
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 5000
        && request.resource.data.timestamp is number;
      allow read, update, delete: if isAdmin();
    }
    match /vehicles/{plate} {
      allow read: if isStaff();
      allow write: if isStaff() && !isKitchen();
    }
    // Branch directory is centrally managed by super administrators.
    // Branch IDs are referenced by staff profiles, POS terminals and operational records.
    match /branches/{branchId} {
      // Branch directory contains customer-facing pickup information.
      allow read: if isSignedIn();
      allow create: if isSuperAdmin()
        && request.resource.data.businessId == 'urban-address'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.code is string
        && request.resource.data.location is map
        && request.resource.data.location.town is string
        && request.resource.data.location.county is string
        && request.resource.data.status in ['ACTIVE', 'INACTIVE'];
      allow update: if isSuperAdmin()
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Global configuration may contain payment credentials; only super-admins read it.
    // The role permissions document remains readable to authenticated staff.
    match /system/{document} {
      allow read: if isSuperAdmin() || (isSignedIn() && document == 'permissions');
      allow write: if isSuperAdmin();
    }
    match /admins/{email} {
      // Every signed-in account may resolve only its own whitelist record.
      // The profile provider checks this document for all users; denying that
      // single get creates a false permission-error toast for ordinary staff
      // and customers. Listing the directory and all mutations stay privileged.
      allow get: if isSignedIn()
        && request.auth.token.email is string
        && email == request.auth.token.email.lower();
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }
    match /settings/{configId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /account_deletion_requests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'userId', 'email', 'displayName', 'requestedAt', 'status', 'source'
        ])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.requestedAt is number
        && request.resource.data.status == 'PENDING'
        && request.resource.data.source == 'CUSTOMER_PROFILE';
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if isAdmin();
      allow create: if isSignedIn()
        && (request.resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.keys().hasAll(['userId', 'title', 'message', 'timestamp', 'read'])
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.timestamp is number
        && request.resource.data.read == false;
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /app_releases/{releaseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /inventory_backups/{backupId} {
      allow read, write: if isAdmin();
    }

    // Server-managed records are accessed through Firebase Admin SDK routes only.
    // Client SDK reads and writes are intentionally denied; Admin SDK bypasses these rules.
    match /email_verification_otps/{uid} {
      allow read, write: if false;
    }
    match /admin_daily_otps/{uid} {
      allow read, write: if false;
    }
    match /email_rate_limits/{limitId} {
      allow read, write: if false;
    }
    match /email_preferences/{preferenceId} {
      allow read, write: if false;
    }
    match /email_outbox/{outboxId} {
      allow read, write: if false;
    }
    match /privacyConsent/{consentId} {
      allow read, write: if false;
    }

    // Unmatched collections remain denied by Firestore's default-deny behavior.
    // Add collection-specific rules rather than broad recursive grants.
  }
}