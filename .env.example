# ==============================================================================
# Urban Auto Express — Environment Variables (Names Only)
# Copy to .env for local development. Never commit real values.
# ==============================================================================

# --- Supabase ---
# Public (exposed to browser at build time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=
# Server-only (local migration & CLI scripts only; not required by Next.js runtime)
DATABASE_URL=
DATABASE_URL_MIGRATIONS=

# --- Site & Security ---
# Public
NEXT_PUBLIC_APP_URL=
# Server-only
STAFF_PIN_PEPPER=

# --- Payments (Paystack, M-Pesa, Airtel Money) ---
# Public
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Server-only
PAYSTACK_SECRET_KEY=
MPESA_ENV=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_TRANSACTION_TYPE=
MPESA_CALLBACK_URL=
AIRTEL_ENV=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_CALLBACK_TOKEN=

# --- AI (Google Gemini via Genkit) ---
# Server-only
GOOGLE_GENAI_API_KEY=

# --- Cron ---
# Server-only
CRON_SECRET=

# --- Cloudflare R2 ---
# Server-only
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Resend & Transactional Email ---
# Server-only
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_SOCIAL_FACEBOOK_URL=
EMAIL_SOCIAL_INSTAGRAM_URL=
EMAIL_SOCIAL_TIKTOK_URL=
EMAIL_SOCIAL_YOUTUBE_URL=

# --- Telegram ---
# Server-only
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
OWNER_TELEGRAM_IDS=
TELEGRAM_USER_ACCESS=
