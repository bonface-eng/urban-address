# firebase & migration backups
firebase-debug.log
firestore-debug.log
# Never commit Firebase Admin service-account credentials or migration exports
/backup/
/migration-output/
serviceAccount*.json
*firebase-admin*.json
*firebase-adminsdk-*.json

.env*
!.env.example
